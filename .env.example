# Copy these into your hosting environment (the app reads real environment variables).
REVIEWER_PASSWORD=change-me-to-a-long-random-passphrase
PORT=3000
HOST=127.0.0.1
# Set to 1 when serving over HTTPS so the session cookie is Secure
COOKIE_SECURE=0
# Set to 1 only behind a reverse proxy you control (uses X-Forwarded-For for rate limits)
TRUST_PROXY=0
# Set to 0 to start with an empty database instead of sample data
SEED_SAMPLE_DATA=1
# Where reports.json and contacts.json are stored
DATA_DIR=./data
